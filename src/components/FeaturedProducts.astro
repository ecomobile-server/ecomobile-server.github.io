---
import "../styles/featured-products.css";

// ponytail: icon files in /public/images/featured/ — rename/add when apps change
const products = [
  {
    name: "V9Show",
    image: "/images/featured/slideshow.png",
    link: "https://play.google.com/store/apps/details?id=com.vtool.photovideomaker.slideshow.videoeditor",
  },
  {
    name: "AI Video Maker",
    image: "/images/featured/v9pic.png",
    link: "https://play.google.com/store/apps/details?id=com.eco.photoeditor.videomaker",
  },
  {
    name: "AI Hairstyle",
    image: "/images/featured/noirify.png",
    link: "https://apps.apple.com/us/app/noirify-ai-hairstyle-try-on/id6767138271?l=vi",
  },
  {
    name: "FlyNote",
    image: "/images/featured/note.png",
    link: "https://play.google.com/store/apps/details?id=com.eco.note",
  },
  {
    name: "PixPDF",
    image: "/images/featured/pdf_reader.png",
    link: "https://play.google.com/store/apps/details?id=com.eco.pdfreader",
  },
  {
    name: "PixScan",
    image: "/images/featured/pdf_scanner.png",
    link: "https://play.google.com/store/apps/details?id=com.eco.ezscanner.scannertoscanpdf",
  },
  {
    name: "ThemePik",
    image: "/images/featured/icon_changer.png",
    link: "https://play.google.com/store/apps/details?id=com.eco.iconchanger.themes",
  },
  {
    name: "QR Code",
    image: "/images/featured/qr_code.png",
    link: "https://play.google.com/store/apps/details?id=com.vtool.qrcodereader.barcodescanner",
  },
  {
    name: "Eatzy",
    image: "/images/featured/food_scanner.png",
    link: "https://play.google.com/store/apps/details?id=com.eco.foodscanner",
  },
  {
    name: "SpeedZen",
    image: "/images/featured/speed_test.png",
    link: "https://play.google.com/store/apps/details?id=com.vtool.speedtest.speedcheck.internet",
  },
];
---

<section class="featured-section">
  <div class="featured-container">
    <h2 class="featured-title">SẢN PHẨM TIÊU BIỂU</h2>
    <div class="featured-scroll">
      <div class="featured-grid">
        {
          [...products, ...products].map((p) => (
            <a
              href={p.link}
              class="featured-item"
              target="_blank"
              rel="noopener noreferrer">
              <img
                src={p.image}
                alt={p.name}
                width="110"
                height="110"
                loading="lazy"
              />
              <p class="featured-name">{p.name}</p>
            </a>
          ))
        }
      </div>
    </div>
    <a
      href="https://www.ecomobile.vn/san-pham/"
      class="featured-more-btn"
      target="_blank"
      rel="noopener noreferrer">
      Xem thêm
      <svg
        width="20"
        height="14"
        viewBox="0 0 20 14"
        fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M0 7H18M18 7L12.5 1.5M18 7L12.5 12.5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>
