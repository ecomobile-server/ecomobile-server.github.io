---
import "../styles/hero.css";

const heroExperimentName = "hero_cta_text_experiment";
const heroControlLabel = "Sẵn sàng thử thách";
const heroDirectApplyLabel = "Ứng tuyển ngay";
---

<section class="hero-section" id="hero">
  <img
    src="/images/hero/background.webp"
    alt="Background Graphic"
    class="hero-bg-graphic"
  />
  <svg
    class="hero-snowflake"
    width="251"
    height="256"
    viewBox="0 0 251 256"
    fill="none"
    xmlns="http://www.w3.org/2000/svg">
    <path
      opacity="0.5"
      d="M251 115.133H172.588L240.493 75.1462L227.878 52.8538L159.967 92.8461L199.179 23.5827L177.321 10.7162L138.115 79.9795V0H112.885V79.9795L73.6785 10.7162L51.8215 23.5827L91.0327 92.8461L23.1221 52.8538L10.5069 75.1462L78.4174 115.133H0V140.867H78.4174L10.5069 180.854L23.1221 203.146L91.0327 163.154L51.8215 232.417L73.6785 245.284L112.885 176.026V256H138.115V176.026L177.321 245.284L199.179 232.417L159.967 163.154L227.878 203.146L240.493 180.854L172.588 140.867H251V115.133Z"
      fill="#BAE9F2"></path>
  </svg>
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        Làm chủ sản phẩm <br />
        <span class="highlight">với Eco Project Manager Program</span>
      </h1>

      <div class="hero-image-container-mobile">
        <!-- TODO: đổi ảnh nhân vật nam trưởng thành/uу tín -->
        <img
          src="/images/hero/hero-team.webp"
          alt="Eco Project Manager Team"
          class="hero-team-img-mobile"
          width="1600"
          height="1250"
        />
        <div class="star star-1"></div>
        <div class="star star-2"></div>
      </div>

      <p class="hero-description">
        Chương trình dành riêng cho những ai mong muốn làm chủ sản phẩm và đam mê
        giải quyết những bài toán kinh doanh để chinh phục thị trường Mobile App
        toàn cầu.
      </p>
      <p class="hero-timeline">
        <strong>Thời gian ứng tuyển: 15/8/26 - 31/1/27</strong>
      </p>
      <a
        href="https://forms.gle/NiqcbMifh4uLr6QB8"
        class="btn-primary"
        data-experiment={heroExperimentName}
        data-ab-ready="false"
        data-control-label={heroControlLabel}
        data-direct-apply-label={heroDirectApplyLabel}
        target="_blank"
        rel="noopener noreferrer">{heroControlLabel}</a
      >
    </div>

    <div class="hero-image-container hero-image-desktop">
      <!-- TODO: đổi ảnh nhân vật nam trưởng thành/uу tín -->
      <img
        src="/images/hero/hero-team.webp"
        alt="Eco Project Manager Team"
        class="hero-team-img"
        width="1600"
        height="1250"
        fetchpriority="high"
      />
      <!-- Decorative stars/sparkles based on typical designs if needed, but we stick to images provided -->
      <div class="star star-1"></div>
      <div class="star star-2"></div>
    </div>
  </div>
</section>

<script>
  import { trackEvent, trackCTAClick, trackPostHogEvent } from "../utils/analytics";

  const HERO_EXPERIMENT_NAME = "hero_cta_text_experiment";
  const HERO_CONTROL_VARIANT = "control";
  const HERO_TREATMENT_VARIANT = "direct_apply";
  const HERO_EXPOSURE_EVENT = "HeroCTA_Experiment_Viewed";
  const HERO_FLAG_TIMEOUT_MS = 1500;

  // Track Hero CTA click
  const heroCTA = document.querySelector(".hero-section .btn-primary");
  if (heroCTA) {
    const controlLabel = heroCTA.getAttribute("data-control-label") || "Sẵn sàng thử thách";
    const directApplyLabel =
      heroCTA.getAttribute("data-direct-apply-label") || "Ứng tuyển ngay";
    let variant = HERO_CONTROL_VARIANT;
    let label = controlLabel;
    let hasTrackedExposure = false;
    let hasResolvedVariant = false;

    const revealButton = () => {
      heroCTA.setAttribute("data-ab-ready", "true");
    };

    const trackExposure = () => {
      if (hasTrackedExposure) return;

      const properties = {
        experiment_name: HERO_EXPERIMENT_NAME,
        experiment_variant: variant,
        cta_label: label,
      };

      trackEvent(HERO_EXPOSURE_EVENT, properties);
      trackPostHogEvent(HERO_EXPOSURE_EVENT, properties);
      hasTrackedExposure = true;
    };

    const applyVariant = () => {
      if (hasResolvedVariant) return;

      const posthogVariant = window.posthog?.getFeatureFlag?.(HERO_EXPERIMENT_NAME);
      const payload = window.posthog?.getFeatureFlagPayload?.(HERO_EXPERIMENT_NAME);

      if (posthogVariant === HERO_TREATMENT_VARIANT) {
        variant = HERO_TREATMENT_VARIANT;
        label =
          typeof payload?.label === "string" && payload.label.trim()
            ? payload.label.trim()
            : directApplyLabel;
      } else {
        variant = HERO_CONTROL_VARIANT;
        label =
          typeof payload?.label === "string" && payload.label.trim()
            ? payload.label.trim()
            : controlLabel;
      }

      heroCTA.textContent = label;
      revealButton();
      trackExposure();
      hasResolvedVariant = true;
    };

    if (window.posthog?.onFeatureFlags) {
      window.posthog.onFeatureFlags(() => {
        applyVariant();
      });

      window.setTimeout(() => {
        applyVariant();
      }, HERO_FLAG_TIMEOUT_MS);
    } else {
      revealButton();
      trackExposure();
      hasResolvedVariant = true;
    }

    heroCTA.addEventListener("click", () => {
      const properties = {
        experiment_name: HERO_EXPERIMENT_NAME,
        experiment_variant: variant,
        cta_label: label,
      };

      trackEvent("Banner_CTA_Clicked", properties);
      trackCTAClick("Hero banner", properties);
      trackPostHogEvent("Banner_CTA_Clicked", properties);
      trackPostHogEvent("LandingPg_CTA_Clicked", {
        cta_position: "Hero banner",
        ...properties,
      });
    });
  }
</script>
