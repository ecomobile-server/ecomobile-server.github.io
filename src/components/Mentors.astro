---
import "../styles/mentors.css";
---

<section class="mentors">
  <div class="mentors-container">
    <h2 class="mentors-title">MENTORS ĐỒNG HÀNH</h2>
    <p class="mentors-subtitle">
      Đội ngũ mentors EPM Gen 2.1 mang đến cho bạn góc nhìn chiến lược toàn diện:
      Tư duy xây dựng doanh nghiệp từ con số 0, quản trị tài chính bền vững &amp;
      kinh nghiệm thực chiến dẫn dắt team liên chức năng. Hành trang này sẽ giúp
      bạn hiểu được bối cảnh thị trường và tự tin cất cánh cùng những đứa con
      tinh thần của mình.
    </p>

    <div class="mentors-grid">
      <div class="mentor-card">
        <div class="mentor-image-wrapper">
          <img
            src="/images/mentors/mentor-1.png"
            alt="Anh Vũ Văn Tường"
            class="mentor-image"
          />
        </div>
        <h3 class="mentor-name">Anh Vũ Văn Tường</h3>
        <p class="mentor-position">Founder, CEO</p>
        <p class="mentor-quote">
          "Hơn 12 năm khởi nghiệp Mobile app, trong đó có 7 năm xây dựng và phát
          triển mô hình Tự quản, môi trường Tổ chức Xanh Ngọc"
        </p>
      </div>

      <div class="mentor-card">
        <div class="mentor-image-wrapper">
          <img
            src="/images/mentors/mentor-2.png"
            alt="Anh Bùi Chí Hướng"
            class="mentor-image"
          />
        </div>
        <h3 class="mentor-name">Anh Bùi Chí Hướng</h3>
        <p class="mentor-position">Project Manager</p>
        <p class="mentor-quote">
          "Hơn 7 năm làm Mobile App qua các vị trí Graphic &amp; UI UX Design,
          Product Owner, Product Marketing, Project Manager, hiện có hơn 2 năm
          làm PM"
        </p>
      </div>

      <div class="mentor-card">
        <div class="mentor-image-wrapper">
          <img
            src="/images/mentors/mentor-3.png"
            alt="Anh Nguyễn Thành Trung"
            class="mentor-image"
          />
        </div>
        <h3 class="mentor-name">Anh Nguyễn Thành Trung</h3>
        <p class="mentor-position">Cố vấn tài chính, chiến lược</p>
        <p class="mentor-quote">
          "Hơn 10 năm khởi nghiệp, cố vấn trong các lĩnh vực: Giáo dục và Agency,
          cùng hơn 4 năm đồng hành lên chiến lược &amp; triển khai xây dựng cộng
          đồng, doanh nghiệp xã hội"
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackSectionView } from "../utils/analytics";

  // Track section visibility
  const section = document.querySelector(".mentors");
  if (section && !section.id) {
    section.id = "mentors";
  }
  trackSectionView("mentors", "MentorSEC_Show");
</script>
