---
import "../styles/benefits.css";
---

<section class="benefits-section" id="benefits">
  <div class="benefits-container">
    <div class="benefits-layout">
      <!-- Left Column -->
      <div class="benefits-intro">
        <div class="decoration-icon">
          <svg
            width="169"
            height="169"
            viewBox="0 0 169 169"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              opacity="0.5"
              d="M108.339 84.5132C141.849 84.5132 169 57.3624 169 23.8526V0H145.174C111.664 0 84.5132 27.1772 84.5132 60.6606C84.5132 27.1772 57.3624 0 23.8526 0H0V23.8526C0 57.3624 27.1772 84.5132 60.6606 84.5132C27.1772 84.5132 0 111.664 0 145.174V169H23.8526C57.3624 169 84.5132 141.849 84.5132 108.339C84.5132 141.849 111.664 169 145.174 169H169V145.174C169 111.664 141.849 84.5132 108.339 84.5132Z"
              fill="#BAE9F2"></path>
          </svg>
        </div>
        <h2 class="benefits-title">GIÁ TRỊ NHẬN ĐƯỢC</h2>
        <p class="benefits-desc">
          Đây là một trong những vị trí được Eco Mobile đầu tư và tâm huyết,
          nhằm kiến tạo một thế hệ Project Manager mới tiếp nối sự đam mê và yêu
          việc làm sản phẩm của chúng tôi.
        </p>
        <a
          href="https://forms.gle/NiqcbMifh4uLr6QB8"
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer">Quan tâm</a
        >
      </div>

      <!-- Right Column -->
      <div class="benefits-grid">
        <!-- Card 1 -->
        <div class="benefit-card">
          <div class="card-header">
            <div class="card-icon">
              <!-- Icon: Chart -->
              <svg
                width="43"
                height="60"
                viewBox="0 0 43 60"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  opacity="0.5"
                  d="M3.83264 4.87217L17.3514 -7.80403e-05H29.0173V48.0361H15.2927V14.3422L6.98931 16.3322L3.83264 4.87217Z"
                  fill="#BAE9F2"></path>
                <rect
                  opacity="0.3"
                  y="39.6963"
                  width="40"
                  height="20"
                  transform="rotate(-10 0 39.6963)"
                  fill="#6AB2FF"></rect>
              </svg>
            </div>
            <h3>Quản trị sản phẩm</h3>
          </div>
          <ul>
            <li>
              Lean startup &amp; hình thành tư duy làm sản phẩm từ con số 0
            </li>
            <li>
              R&amp;D để hiểu người dùng, sản phẩm, thị trường để xác định cơ
              hội kinh doanh
            </li>
            <li>
              Chịu trách nhiệm end-to-end cho sản phẩm: lộ trình phát triển sản
              phẩm, tính năng
            </li>
            <li>Xây dựng mô hình kinh doanh bền vững, tối ưu dòng tiền PL2</li>
            <li>Ra quyết định dựa trên dữ liệu và hướng tới người dùng</li>
          </ul>
        </div>

        <!-- Card 2 -->
        <div class="benefit-card blue-card">
          <div class="card-header">
            <div class="card-icon">
              <!-- Icon: User/Management -->
              <svg
                width="43"
                height="62"
                viewBox="0 0 43 62"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  opacity="0.65"
                  d="M39.5037 49.1343H4.78042V39.1153L20.4265 22.1654L21.5931 20.8615C22.6911 19.7636 22.8969 19.5577 23.5145 18.8028C24.4066 17.7735 24.7498 17.0186 24.7498 16.0579C24.7498 14.4796 23.6518 13.313 21.5245 13.313C18.9854 13.313 17.064 14.9599 15.8288 18.1852L3.75107 11.5974C6.97636 3.98024 13.6328 9.78972e-05 21.3186 9.78972e-05C26.0536 9.78972e-05 30.0337 1.37256 33.3963 4.04887C36.7588 6.72517 38.4744 10.3622 38.4744 15.0972C38.4744 17.9794 37.8568 20.5184 36.5529 22.6457C35.3177 24.7731 33.3277 27.3807 30.6514 30.4002L25.7791 35.8214H39.5037V49.1343Z"
                  fill="white"></path>
                <rect
                  opacity="0.3"
                  y="41.9055"
                  width="40"
                  height="20"
                  transform="rotate(-10 0 41.9055)"
                  fill="#6AB2FF"></rect>
              </svg>
            </div>
            <h3>Quản trị đội nhóm</h3>
          </div>
          <ul>
            <li>
              Quản trị theo mô hình Tự quản, nhân sự tự ra quyết định và tự chịu
              trách nhiệm
            </li>
            <li>
              Xây dựng &amp; phối hợp với đội ngũ liên chức năng (Marketing,
              Designer, Developer, Tester, Backend,...)
            </li>
            <li>
              Xây dựng cơ chế và phân bổ thưởng kinh doanh dựa theo đóng góp của
              nhân sự
            </li>
          </ul>
        </div>

        <!-- Card 3 -->
        <div class="benefit-card blue-card">
          <div class="card-header">
            <div class="card-icon">
              <!-- Icon: Group/Mentor -->
              <svg
                width="43"
                height="61"
                viewBox="0 0 43 61"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  opacity="0.65"
                  d="M36.8274 10.5679L29.2103 19.6261C35.455 21.479 39.4351 26.0767 39.4351 32.939C39.4351 38.223 37.7195 42.2718 34.357 45.0167C30.9945 47.7616 26.7398 49.1341 21.5931 49.1341C13.1524 49.1341 6.496 45.2226 3.75107 37.7427L15.8288 30.8117C16.7895 34.1743 18.7109 35.8212 21.5931 35.8212C24.0635 35.8212 25.7105 34.4487 25.7105 32.2528C25.7105 29.9882 24.338 28.8216 21.5931 28.8216H18.6423L13.2897 20.8614L19.7403 13.3128H5.26078V-7.80403e-05H36.8274V10.5679Z"
                  fill="white"></path>
                <rect
                  opacity="0.3"
                  y="40.8074"
                  width="40"
                  height="20"
                  transform="rotate(-10 0 40.8074)"
                  fill="#6AB2FF"></rect>
              </svg>
            </div>
            <h3>Đồng hành & thực chiến</h3>
          </div>
          <ul>
            <li>
              Tham gia trực tiếp xây dựng và tối ưu sản phẩm cùng đội ngũ liên
              chức năng
            </li>
            <li>
              Được mentor 1-1 trong suốt thời gian tham gia chương trình bởi đội
              ngũ Mentors giàu kinh nghiệm
            </li>
            <li>
              Được tôn trọng quan điểm, lắng nghe và tư vấn về định hướng công
              việc dựa theo mục tiêu cá nhân
            </li>
          </ul>
        </div>

        <!-- Card 4 -->
        <div class="benefit-card">
          <div class="card-header">
            <div class="card-icon">
              <!-- Icon: Briefcase -->
              <svg
                width="44"
                height="60"
                viewBox="0 0 44 60"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  opacity="0.5"
                  d="M38.1441 28.6844H42.9477V41.0366H38.1441V48.0361H24.694V41.0366H4.51875V28.6844L17.763 -7.80403e-05H33.3405L19.8903 28.6844H24.694V21.9593H38.1441V28.6844Z"
                  fill="#BAE9F2"></path>
                <rect
                  opacity="0.3"
                  y="39.6963"
                  width="40"
                  height="20"
                  transform="rotate(-10 0 39.6963)"
                  fill="#6AB2FF"></rect>
              </svg>
            </div>
            <h3>Cơ hội nghề nghiệp</h3>
          </div>
          <ul>
            <li>
              Được học hỏi, sáng tạo không ngừng từ việc tối ưu sản phẩm vì
              người dùng
            </li>
            <li>Lộ trình trở thành PM chính thức tại Eco Mobile</li>
            <li>Cơ chế tự nhận lương theo đúng năng lực khi lên chính thức</li>
            <li>
              Cơ chế tăng lương và thưởng kinh doanh 2 kỳ 1 năm khi lên chính
              thức
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    trackSectionView,
    trackEvent,
    trackCTAClick,
  } from "../utils/analytics";

  // Track section visibility
  trackSectionView("benefits", "ValueSEC_Show");

  // Track CTA click in Benefits section
  const benefitsCTA = document.querySelector(".benefits-section .btn-primary");
  if (benefitsCTA) {
    benefitsCTA.addEventListener("click", () => {
      trackEvent("ValueSEC_CTA_Clicked");
      trackCTAClick("Giá trị");
    });
  }
</script>
